<section class="age-utility-workflow__surface age-rule-profile-manager colorset-selection" aria-labelledby="age-rule-profile-title">
  <header class="age-utility-workflow__header colorset-first-tier">
    <div>
      <h1 id="age-rule-profile-title"><i class="fa-solid fa-sliders" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.ruleProfiles"}}</h1>
      <p class="age-profile-active">{{localize "age-system.AUTOMATION.activeProfile" profile=activeProfileLabel}}</p>
    </div>
  </header>

  <div class="age-utility-workflow__scroll age-profile-scroll">
    {{#unless automationEnabled}}
    <p class="notification warning" role="alert">{{localize "age-system.AUTOMATION.disabled"}}</p>
    {{/unless}}
    {{#if operationError}}
    <p class="notification error" role="alert">{{operationError}}</p>
    {{/if}}

    <section class="age-utility-workflow__panel age-profile-selection-panel">
      <div class="age-profile-selector age-utility-workflow__grid age-utility-workflow__grid--two">
        <label for="age-rule-profile-select">{{localize "age-system.AUTOMATION.profile"}}</label>
        <select id="age-rule-profile-select" name="profile" {{#if busy}}disabled{{/if}}>
          {{#select selectedProfileId}}
          {{#each profiles as |profile|}}
          <option value="{{profile.id}}">{{profile.localizedLabel}}</option>
          {{/each}}
          {{/select}}
        </select>
      </div>

      <section class="age-profile-summary age-utility-workflow__card">
        <h2>{{selectedLabel}}</h2>
        <p class="notes">{{selectedDescription}}</p>
        <p class="notes age-profile-active">{{localize "age-system.AUTOMATION.activeProfile" profile=activeProfileLabel}}</p>
      </section>
    </section>

    <section class="age-utility-workflow__panel age-profile-table-scroll">
      <table>
        <thead>
          <tr>
            <th scope="col">{{localize "age-system.AUTOMATION.setting"}}</th>
            <th scope="col">{{localize "age-system.AUTOMATION.currentValue"}}</th>
            <th scope="col">{{localize "age-system.AUTOMATION.proposedValue"}}</th>
            <th scope="col">{{localize "age-system.AUTOMATION.reload"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows as |row|}}
          <tr class="{{#if row.changed}}is-changed{{/if}}">
            <th scope="row">{{row.name}}</th>
            <td>{{row.currentLabel}}</td>
            <td>{{#if row.changed}}<strong>{{row.proposedLabel}}</strong>{{else}}{{row.proposedLabel}}{{/if}}</td>
            <td>{{#if row.requiresReload}}<i class="fa-solid fa-rotate" title="{{localize 'age-system.AUTOMATION.reloadRequired'}}" aria-label="{{localize 'age-system.AUTOMATION.reloadRequired'}}"></i>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </section>
  </div>

  <footer class="age-utility-workflow__footer age-profile-actions">
    <button type="button" class="apply-rule-profile" data-action="applyProfile" {{#unless automationEnabled}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-check" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.applyProfile"}}
    </button>
    <button type="button" class="revert-rule-profile" data-action="revertProfile" {{#unless canRevert}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.restoreProfile"}}
    </button>
  </footer>
</section>
