<section class="age-utility-workflow__surface age-compendium-search colorset-selection" aria-labelledby="age-library-search-title">
  <header class="age-utility-workflow__header colorset-first-tier">
    <div>
      <h1 id="age-library-search-title"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.librarySearch"}}</h1>
      <p>{{localize "age-system.AUTOMATION.libraryIndexStatus" count=indexCount profile=profileLabel}}</p>
    </div>
  </header>

  <section class="age-utility-workflow__panel age-library-controls" aria-label="{{localize 'age-system.AUTOMATION.search'}}">
    {{#unless automationEnabled}}
    <p class="notification warning" role="alert">{{localize "age-system.AUTOMATION.disabled"}}</p>
    {{/unless}}
    {{#if operationError}}
    <p class="notification error" role="alert">{{operationError}}</p>
    {{/if}}

    <form class="age-library-toolbar age-utility-workflow__grid">
      <label class="age-library-field age-utility-workflow__field">
        <span>{{localize "age-system.AUTOMATION.search"}}</span>
        <input type="search" name="query" value="{{query}}" autofocus {{#unless automationEnabled}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
      </label>
      <label class="age-library-field age-utility-workflow__field">
        <span>{{localize "age-system.AUTOMATION.documentType"}}</span>
        <select name="documentName" {{#unless automationEnabled}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
          {{#select documentName}}
          <option value="">{{localize "age-system.AUTOMATION.allDocuments"}}</option>
          <option value="Actor">{{localize "DOCUMENT.Actors"}}</option>
          <option value="Item">{{localize "DOCUMENT.Items"}}</option>
          <option value="JournalEntry">{{localize "DOCUMENT.JournalEntries"}}</option>
          <option value="RollTable">{{localize "DOCUMENT.RollTables"}}</option>
          {{/select}}
        </select>
      </label>
      <button type="button" data-action="search" class="age-library-search" {{#unless automationEnabled}}disabled{{/unless}} {{#if busy}}disabled{{/if}}>
        <i class="fa-solid fa-search" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.search"}}
      </button>
    </form>
  </section>

  <div class="age-utility-workflow__scroll age-library-scroll">
    {{#if indexErrors.length}}
    <p class="notification warning" role="alert">{{localize "age-system.AUTOMATION.indexWarnings" count=indexErrors.length}}</p>
    {{/if}}

    <section class="age-utility-workflow__panel age-library-results-panel">
      <ol class="directory-list age-library-results age-utility-workflow__list" aria-live="polite">
        {{#each results as |result|}}
        <li class="directory-item age-library-result age-utility-workflow__row">
          <div class="age-library-icon">
            {{#if result.img}}<img src="{{result.img}}" alt="">{{else}}<i class="fa-solid fa-book" aria-hidden="true"></i>{{/if}}
          </div>
          <div class="age-library-result-copy">
            <strong title="{{result.name}}">{{result.displayName}}</strong>
            <div class="notes">{{result.documentName}} · {{result.type}} · {{result.packLabel}}</div>
            <div class="notes age-library-source-id" title="{{result.uuid}}">{{result.pack}} · {{result.id}}</div>
          </div>
          <button type="button" class="age-library-open" data-action="openDocument" data-uuid="{{result.uuid}}" {{#if ../busy}}disabled{{/if}}>
            <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.open"}}
          </button>
        </li>
        {{else}}
        <li class="directory-item age-library-empty age-utility-workflow__empty"><p class="notes">{{localize "age-system.AUTOMATION.noSearchResults"}}</p></li>
        {{/each}}
      </ol>
    </section>
  </div>

  <footer class="age-utility-workflow__footer age-library-status">
    <span class="notes">{{localize "age-system.AUTOMATION.libraryIndexStatus" count=indexCount profile=profileLabel}}</span>
    {{#if automationEnabled}}{{#if isGM}}
    <button type="button" class="age-library-rebuild" data-action="rebuild" {{#if busy}}disabled{{/if}}>
      <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.rebuildIndex"}}
    </button>
    {{/if}}{{/if}}
  </footer>
</section>
