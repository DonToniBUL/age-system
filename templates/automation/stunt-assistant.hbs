<section class="age-utility-workflow__surface age-stunt-assistant colorset-selection" aria-labelledby="age-stunt-assistant-title">
  <header class="age-utility-workflow__header colorset-first-tier">
    <div>
      <h1 id="age-stunt-assistant-title">{{localize "age-system.AUTOMATION.stuntAssistant"}}</h1>
      {{#if state}}<p>{{state.actorName}}</p>{{/if}}
    </div>
    <i class="fa-solid fa-wand-sparkles" aria-hidden="true"></i>
  </header>

  <main class="age-utility-workflow__scroll">
    {{#unless enabled}}<p class="notification warning">{{localize "age-system.AUTOMATION.disabled"}}</p>{{/unless}}
    {{#unless messageAvailable}}<p class="notification warning">{{localize "age-system.AUTOMATION.stuntMessageUnavailable"}}</p>{{/unless}}

    {{#if state}}
      <section class="age-utility-workflow__grid age-stunt-summary">
        <div class="age-utility-workflow__card age-stunt-stat"><span class="notes">{{localize "age-system.AUTOMATION.generatedSP"}}</span><strong>{{state.total}}</strong></div>
        <div class="age-utility-workflow__card age-stunt-stat"><span class="notes">{{localize "age-system.AUTOMATION.spentSP"}}</span><strong>{{#each state.spends}}{{cost}}{{#unless @last}} + {{/unless}}{{else}}0{{/each}}</strong></div>
        <div class="age-utility-workflow__card age-stunt-stat"><span class="notes">{{localize "age-system.AUTOMATION.remainingSP"}}</span><strong>{{state.remaining}}</strong></div>
      </section>
    {{/if}}

    <form class="age-utility-workflow__panel age-utility-workflow__grid age-stunt-filter colorset-second-tier">
      <label class="age-utility-workflow__field"><span>{{localize "age-system.AUTOMATION.search"}}</span><input type="search" name="query" value="{{query}}"></label>
      <label class="age-utility-workflow__field"><span>{{localize "age-system.AUTOMATION.stuntCategory"}}</span><select name="category">{{#select category}}<option value="">{{localize "age-system.AUTOMATION.allCategories"}}</option>{{#each categories as |name|}}<option value="{{name}}">{{name}}</option>{{/each}}{{/select}}</select></label>
      <label class="age-stunt-checkbox"><input type="checkbox" name="showUnaffordable" {{checked showUnaffordable}}> {{localize "age-system.AUTOMATION.showUnaffordable"}}</label>
      <button type="submit"><i class="fa-solid fa-filter" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.filter"}}</button>
    </form>

    <ol class="directory-list age-utility-workflow__list age-stunt-results">
      {{#each candidates as |stunt|}}
        <li class="directory-item age-utility-workflow__card age-stunt-row {{#unless stunt.affordable}}unaffordable{{/unless}}" data-stunt-uuid="{{stunt.uuid}}">
          <div class="age-utility-workflow__card-header">
            <div class="age-stunt-copy"><strong>{{stunt.name}}{{#if stunt.recommended}} <i class="fa-solid fa-star" title="{{localize 'age-system.AUTOMATION.recommendedStunt'}}"></i>{{/if}}</strong><span class="notes">{{#if stunt.category}}{{stunt.category}} · {{/if}}{{stunt.sourceLabel}}</span></div>
            <div class="age-utility-workflow__actions">
              <label class="age-utility-workflow__field age-stunt-cost"><input type="number" name="stuntCost" value="{{stunt.minimum}}" min="{{stunt.minimum}}" max="{{stunt.maximum}}" {{#unless stunt.variable}}readonly{{/unless}}> <span>SP</span></label>
              <button type="button" class="age-stunt-open" data-action="openStunt" title="{{localize 'age-system.AUTOMATION.open'}}" aria-label="{{localize 'age-system.AUTOMATION.open'}}"><i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i></button>
              <button type="button" class="age-stunt-spend" data-action="spend" {{#unless stunt.affordable}}disabled{{/unless}}><i class="fa-solid fa-coins" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.spend"}}</button>
            </div>
          </div>
        </li>
      {{else}}
        <li class="directory-item age-utility-workflow__empty age-stunt-empty"><p class="notes">{{localize "age-system.AUTOMATION.noStuntsFound"}}</p></li>
      {{/each}}
    </ol>
  </main>

  <footer class="age-utility-workflow__footer age-stunt-footer">
    <div class="age-stunt-spent notes">{{#each state.spends}}{{name}} ({{cost}} SP){{#unless @last}} · {{/unless}}{{else}}{{localize "age-system.AUTOMATION.noStuntsSpent"}}{{/each}}</div>
    <button type="button" class="age-stunt-undo" data-action="undo" {{#unless canUndo}}disabled{{/unless}}><i class="fa-solid fa-rotate-left" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.undoLastSpend"}}</button>
  </footer>
</section>
