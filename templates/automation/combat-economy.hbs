<section class="age-utility-workflow__surface age-combat-economy colorset-selection" aria-labelledby="age-combat-economy-title">
  <header class="age-utility-workflow__header colorset-first-tier">
    <div>
      <span class="age-utility-workflow__kicker">{{localize "age-system.AUTOMATION.combatEconomy"}}</span>
      <h1 id="age-combat-economy-title">{{#if actor}}{{actor.name}}{{else}}{{localize "age-system.AUTOMATION.combatEconomy"}}{{/if}}</h1>
    </div>
    <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
  </header>

  <div class="age-utility-workflow__scroll">
    {{#if actor}}
    <section class="age-utility-workflow__panel colorset-second-tier" aria-labelledby="age-combat-economy-actions-title">
      <div class="age-utility-workflow__heading">
        <h2 id="age-combat-economy-actions-title">{{localize "age-system.AUTOMATION.combatEconomy"}}</h2>
      </div>

      <div class="age-utility-workflow__grid age-combat-economy__totals" role="list">
        <article class="age-utility-workflow__card age-combat-economy__total" role="listitem">
          <strong>{{state.major}}</strong>
          <span>{{localize "age-system.AUTOMATION.majorActions"}}</span>
        </article>
        <article class="age-utility-workflow__card age-combat-economy__total" role="listitem">
          <strong>{{state.minor}}</strong>
          <span>{{localize "age-system.AUTOMATION.minorActions"}}</span>
        </article>
        <article class="age-utility-workflow__card age-combat-economy__total" role="listitem">
          <strong>{{state.free}}</strong>
          <span>{{localize "age-system.AUTOMATION.freeActions"}}</span>
        </article>
      </div>

      {{#unless evaluation.legal}}
      <p class="age-utility-workflow__notice notification warning" role="alert">
        {{localize "age-system.AUTOMATION.actionEconomyExceeded"}}
      </p>
      {{/unless}}

      <div class="age-utility-workflow__actions age-combat-economy__actions" role="group" aria-label="{{localize 'age-system.AUTOMATION.combatEconomy'}}">
        <button type="button" data-action="record" data-economy-type="major" data-label="Manual major action">
          <i class="fa-solid fa-circle" aria-hidden="true"></i>
          {{localize "age-system.AUTOMATION.markMajor"}}
        </button>
        <button type="button" data-action="record" data-economy-type="minor" data-label="Manual minor action">
          <i class="fa-regular fa-circle" aria-hidden="true"></i>
          {{localize "age-system.AUTOMATION.markMinor"}}
        </button>
        <button type="button" data-action="record" data-economy-type="free" data-label="Manual free action">
          <i class="fa-solid fa-bolt" aria-hidden="true"></i>
          {{localize "age-system.AUTOMATION.markFree"}}
        </button>
        <button type="button" class="age-economy-undo" data-action="undo" {{#unless history.length}}disabled{{/unless}}>
          <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
          {{localize "age-system.AUTOMATION.undoLastActionMark"}}
        </button>
      </div>
    </section>

    <section class="age-utility-workflow__panel colorset-second-tier" aria-labelledby="age-combat-economy-history-title">
      <div class="age-utility-workflow__heading">
        <h2 id="age-combat-economy-history-title">{{localize "age-system.AUTOMATION.recentActionDiagnostics"}}</h2>
        <span class="age-utility-workflow__badge">{{history.length}}</span>
      </div>
      <ol class="age-utility-workflow__list age-combat-economy__history" role="list">
        {{#each history as |entry|}}
        <li class="age-utility-workflow__row age-combat-economy__history-entry">
          <strong>{{entry.type}}</strong>
          <span>{{entry.label}}</span>
          {{#if entry.offTurn}}<small>({{localize "age-system.AUTOMATION.offTurn"}})</small>{{/if}}
        </li>
        {{else}}
        <li class="age-utility-workflow__empty notes" role="status">{{localize "age-system.AUTOMATION.noActionsRecorded"}}</li>
        {{/each}}
      </ol>
    </section>
    {{else}}
    <p class="age-utility-workflow__notice notification warning" role="alert">
      {{localize "age-system.AUTOMATION.noActiveCombatant"}}
    </p>
    {{/if}}
  </div>
</section>
