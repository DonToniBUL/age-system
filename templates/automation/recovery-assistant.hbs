<form class="age-utility-workflow__surface age-recovery-assistant age-recovery-form colorset-selection" aria-labelledby="age-recovery-assistant-title">
  <header class="age-utility-workflow__header colorset-first-tier">
    <div><h1 id="age-recovery-assistant-title">{{localize "age-system.AUTOMATION.recoveryAssistant"}}</h1></div>
    <i class="fa-solid fa-bed" aria-hidden="true"></i>
  </header>

  <main class="age-utility-workflow__scroll">
    <p class="notification info">{{localize "age-system.AUTOMATION.recoveryProfile" mode=gameMode}}</p>

    <section class="age-utility-workflow__panel age-utility-workflow__grid age-utility-workflow__grid--two age-recovery-options colorset-second-tier">
      <label class="age-utility-workflow__field"><span>{{localize "age-system.AUTOMATION.recoveryType"}}</span><select name="kind"><option value="breather">{{localize "age-system.AUTOMATION.recovery.breather"}}</option><option value="sleep">{{localize "age-system.AUTOMATION.recovery.sleep"}}</option></select></label>
      {{#if isGritty}}<label class="age-recovery-option"><input type="checkbox" name="grittyWoundDamage"> {{localize "age-system.AUTOMATION.grittyWoundDamage"}}</label>{{/if}}
      {{#if isCinematic}}<label class="age-recovery-option"><input type="checkbox" name="cinematicOnlyStun"> {{localize "age-system.AUTOMATION.cinematicOnlyStun"}}</label>{{/if}}
    </section>

    <ol class="directory-list age-utility-workflow__list age-recovery-actors">
      {{#each actors as |actor|}}
        <li class="directory-item age-utility-workflow__row age-recovery-actor">
          <label class="age-utility-workflow__actions">
            <input type="checkbox" name="actorUuid" value="{{actor.uuid}}" {{checked actor.selected}} aria-label="{{actor.name}}">
            <img src="{{actor.img}}" alt="" width="32" height="32">
            <span class="age-recovery-actor-copy"><strong>{{actor.name}}</strong><span class="notes">{{actor.health}} / {{actor.maxHealth}} HP</span></span>
          </label>
        </li>
      {{/each}}
    </ol>
  </main>

  <footer class="age-utility-workflow__footer age-recovery-footer">
    <button type="button" data-action="apply"><i class="fa-solid fa-briefcase-medical" aria-hidden="true"></i> {{localize "age-system.AUTOMATION.applyRecovery"}}</button>
  </footer>
</form>
