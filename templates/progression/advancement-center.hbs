<section class="age-advancement-center__surface">
  <header class="age-advancement-center__header">
    <div>
      <span class="age-advancement-center__kicker">Your next advancement</span>
      <h1>Advancement Center</h1>
      <p>Make the choices for the next rank, review what changes, then apply it. Nothing changes before confirmation.</p>
    </div>
    {{#if preview}}
    <div class="age-advancement-center__preview-state {{#if previewExpiring}}is-warning{{/if}} {{#if previewExpired}}is-error{{/if}}">
      <strong>{{#if previewExpired}}Expired{{else}}Signed preview{{/if}}</strong>
      <span>{{previewRemaining}}s remaining</span>
    </div>
    {{/if}}
  </header>

  <nav class="age-advancement-center__steps" aria-label="Advancement steps">
    {{#each workflowStages as |step|}}
    <button type="button" class="{{#if step.complete}}is-complete{{/if}} {{#if step.current}}is-current{{/if}}"
            data-age-advancement-scroll="{{step.id}}" {{#if step.current}}aria-current="step"{{/if}}>
      <b>{{#if step.complete}}<i class="fa-solid fa-check" aria-label="Complete"></i>{{else}}{{step.number}}{{/if}}</b>
      <small>{{step.label}}</small>
    </button>
    {{#unless @last}}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{{/unless}}
    {{/each}}
  </nav>

  <div class="age-advancement-center__scroll">
    <section class="age-advancement-center__panel age-advancement-center__selectors" data-age-advancement-stage="path">
      <label>
        <span>Owned Character</span>
        <select data-age-advancement-change="actor" {{#if busy}}disabled{{/if}}>
          {{#each actors as |entry|}}
          <option value="{{entry.uuid}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}}</option>
          {{/each}}
        </select>
      </label>
      {{#if usesClassTrack}}<label>
        <span>Owned Class</span>
        <select data-age-advancement-change="class" {{#if busy}}disabled{{/if}}>
          {{#each classes as |entry|}}
          <option value="{{entry.id}}" {{#if entry.selected}}selected{{/if}}>{{entry.name}} · Rank {{entry.level}}</option>
          {{/each}}
        </select>
      </label>{{/if}}
      <label>
        <span>Advancement path</span>
        <select data-age-advancement-change="definition" {{#if busy}}disabled{{/if}}>
          {{#each definitions as |entry|}}
          <option value="{{entry.id}}" {{#if entry.selected}}selected{{/if}} {{#unless entry.compatible}}disabled{{/unless}}>{{entry.label}} · {{#if entry.available}}rank {{entry.currentRank}} → {{entry.targetRank}}{{else}}{{entry.state}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
    </section>

    {{#if definition}}
    <section class="age-advancement-center__rank">
      <div><span>Profile</span><strong>{{profileId}}</strong></div>
      <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      <div><span>Current rank</span><strong>{{currentRank}}</strong></div>
      <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
      <div><span>Target rank</span><strong>{{targetRank}}</strong></div>
      <div><span>Definition</span><strong>{{providerLabel}}</strong><small>{{definition.id}}</small></div>
    </section>

    <section class="age-advancement-center__availability age-advancement-center__availability--{{availability.state}}">
      <i class="fa-solid {{#if advancementAvailable}}fa-circle-check{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
      <div><strong>{{#if advancementAvailable}}Advancement available{{else}}Advancement unavailable{{/if}}</strong><span>{{availabilityMessage}}</span></div>
    </section>

    <details class="age-advancement-center__technical">
      <summary><i class="fa-solid fa-circle-info"></i> Rules source and validation details</summary>
    <div class="age-advancement-center__grid">
      <section class="age-advancement-center__panel">
        <header class="age-advancement-center__panel-heading">
          <div><span>Provenance</span><h2>Sources</h2></div>
          {{#if provider}}<small>{{providerKindLabel}} · {{providerLabel}}</small>{{/if}}
        </header>
        <div class="age-advancement-center__source-list">
          {{#each sources as |source|}}
          <article>
            <strong>{{source.label}}</strong>
            <span>{{source.kind}} · {{source.detail}}</span>
          </article>
          {{else}}
          <p class="age-advancement-center__empty">No source references declared.</p>
          {{/each}}
        </div>
      </section>

      <section class="age-advancement-center__panel">
        <header class="age-advancement-center__panel-heading">
          <div><span>Contract</span><h2>Validation</h2></div>
          {{#if definitionErrors.length}}<i class="fa-solid fa-triangle-exclamation"></i>{{else}}<i class="fa-solid fa-circle-check"></i>{{/if}}
        </header>
        {{#if definitionErrors.length}}
        <ul class="age-advancement-center__issues is-error">{{#each definitionErrors as |error|}}<li>{{error}}</li>{{/each}}</ul>
        {{else}}
          <p class="age-advancement-center__valid"><i class="fa-solid fa-shield-check"></i> This progression definition is valid and active.</p>
        {{/if}}
        {{#if inputErrors.length}}
        <ul class="age-advancement-center__issues is-warning">{{#each inputErrors as |error|}}<li>{{error}}</li>{{/each}}</ul>
        {{/if}}
        {{#if previewError}}
          <div class="age-advancement-center__error"><strong>{{#if previewError.dependency}}Required content unavailable{{else}}Preview unavailable{{/if}}</strong><span>{{previewError.message}}</span></div>
        {{/if}}
        {{#if undoError}}
        <div class="age-advancement-center__error"><strong>Undo unavailable</strong><span>{{undoError.message}}</span></div>
        {{/if}}
      </section>
    </div>
    </details>

    <div class="age-advancement-center__stage-anchor" data-age-advancement-stage="choices" aria-hidden="true"></div>
    {{#each choiceGroups as |group|}}
    {{#if group.available}}
    <section class="age-advancement-center__panel" data-age-advancement-choice-group="{{group.id}}">
      <header class="age-advancement-center__panel-heading">
        <div><span>{{group.instruction}}</span><h2>{{group.label}}</h2></div>
        <small>{{group.minimum}}–{{group.maximum}} selections</small>
      </header>
      {{#if group.searchable}}
      <div class="age-advancement-center__choice-tools">
        <label class="age-advancement-center__choice-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input type="search" placeholder="Search {{group.label}}…" aria-label="Search {{group.label}}"
                 data-age-advancement-choice-filter data-group-id="{{group.id}}" autocomplete="off">
        </label>
        <label class="age-advancement-center__choice-selected-only">
          <input type="checkbox" data-age-advancement-choice-selected data-group-id="{{group.id}}"> Selected only
        </label>
        <button type="button" data-age-advancement-action="clear-choice-filter"><i class="fa-solid fa-filter-circle-xmark"></i> Clear</button>
        <output><strong>{{group.selectedCount}}</strong> selected · <strong data-age-advancement-choice-visible>{{group.optionCount}}</strong> shown</output>
      </div>
      {{/if}}
      <div class="age-advancement-center__choice-grid">
        {{#each group.options as |option|}}
        <label class="age-advancement-center__choice {{#if option.selected}}is-selected{{/if}} {{#if option.unavailable}}is-unavailable{{/if}}"
               data-age-advancement-choice-option data-search-text="{{option.searchText}}">
          <input type="checkbox" data-age-advancement-change="choice" data-group-id="{{group.id}}" data-option-id="{{option.id}}" {{checked option.selected}} {{#if option.unavailable}}disabled{{else}}{{#if ../../busy}}disabled{{/if}}{{/if}}/>
          <span><strong>{{option.label}}</strong>{{#if option.detail}}<small>{{option.detail}}</small>{{/if}}{{#if option.unavailable}}<small class="age-advancement-center__choice-blocker"><i class="fa-solid fa-ban" aria-hidden="true"></i> {{option.unavailableReason}}</small>{{/if}}</span>
        </label>
        {{/each}}
      </div>
      <p class="age-advancement-center__choice-empty" data-age-advancement-choice-empty hidden>No matching options.</p>
    </section>
    {{/if}}
    {{/each}}

    {{#each abilityGroups as |group|}}
    <section class="age-advancement-center__panel">
      <header class="age-advancement-center__panel-heading">
        <div><span>Distribute your points</span><h2>{{group.label}}</h2></div>
        <strong class="age-advancement-center__counter">{{group.spent}} / {{group.points}} · {{group.remaining}} remaining</strong>
      </header>
      <div class="age-advancement-center__ability-grid">
        {{#each group.options as |ability|}}
        <label>
          <span><strong>{{ability.name}}</strong><small>Current {{ability.current}}</small></span>
          <input type="number" min="0" step="1" value="{{ability.allocation}}" data-age-advancement-change="ability" data-operation-id="{{group.operationId}}" data-ability-id="{{ability.id}}" {{#if ../../busy}}disabled{{/if}}/>
        </label>
        {{/each}}
      </div>
    </section>
    {{/each}}

    {{#if targetGroups.length}}
    <section class="age-advancement-center__panel">
      <header class="age-advancement-center__panel-heading">
        <div><span>Existing Item handling</span><h2>Reuse or improve owned Items</h2></div>
        <small>Only compatible Items are offered</small>
      </header>
      <div class="age-advancement-center__target-list">
        {{#each targetGroups as |target|}}
        <label>
          <span><strong>{{target.label}}</strong><small>{{target.help}}</small></span>
          <select data-age-advancement-change="target" data-operation-id="{{target.operationId}}" {{#if ../busy}}disabled{{/if}}>
            <option value="">{{#if target.required}}Select an owned {{target.itemLabel}}{{else}}Add {{target.itemLabel}} as a new Item{{/if}}</option>
            {{#each target.candidates as |candidate|}}
            <option value="{{candidate.id}}" {{#if candidate.selected}}selected{{/if}}>{{candidate.name}}</option>
            {{/each}}
          </select>
        </label>
        {{/each}}
      </div>
    </section>
    {{/if}}

    <details class="age-advancement-center__technical">
      <summary><i class="fa-solid fa-dice"></i> Advanced preview details: formula rolls</summary>
    <div class="age-advancement-center__grid age-advancement-center__grid--preview">
      <section class="age-advancement-center__panel">
        <header class="age-advancement-center__panel-heading">
          <div><span>Resolved at preview time</span><h2>Pinned formulas</h2></div>
          {{#if preview}}<i class="fa-solid fa-lock"></i>{{/if}}
        </header>
        <div class="age-advancement-center__formula-list">
          {{#each formulas as |formula|}}
          <article>
            <span><strong>{{formula.formula}}</strong><small>{{formula.operationId}}</small></span>
            <b>{{formula.result}}</b>
            <button type="button" data-age-advancement-action="reroll" data-operation-id="{{formula.operationId}}" title="Create a new signed preview with a new result"><i class="fa-solid fa-dice"></i></button>
          </article>
          {{else}}
          <p class="age-advancement-center__empty">This milestone has no formulas.</p>
          {{/each}}
        </div>
      </section>

      <section class="age-advancement-center__panel">
        <header class="age-advancement-center__panel-heading">
          <div><span>Technical plan</span><h2>Resolved effects</h2></div>
          <small>{{effects.length}} operation(s)</small>
        </header>
        <ol class="age-advancement-center__effect-list">
          {{#each effects as |effect|}}
          <li><span>{{effect.display}}</span></li>
          {{else}}
          <li class="age-advancement-center__empty">No effects at this rank.</li>
          {{/each}}
        </ol>
      </section>
    </div>
    </details>

    <section class="age-advancement-center__panel age-advancement-center__review" data-age-advancement-stage="review">
      <header class="age-advancement-center__panel-heading">
        <div><span>Review</span><h2>What will change at rank {{targetRank}}</h2></div>
        <small>{{effects.length}} change(s)</small>
      </header>
      <ol class="age-advancement-center__effect-list">
        {{#each effects as |effect|}}<li><span>{{effect.display}}</span></li>{{else}}<li class="age-advancement-center__empty">No changes are defined for this rank.</li>{{/each}}
      </ol>
    </section>

    {{#if summary.length}}
    <section class="age-advancement-center__summary">
      <strong>Advancement summary</strong>
      <ul>{{#each summary as |entry|}}<li>{{entry}}</li>{{/each}}</ul>
    </section>
    {{/if}}

    {{#if receiptResult}}
    <section class="age-advancement-center__receipt-result age-advancement-center__receipt-result--{{receiptResult.state}}">
      <i class="fa-solid {{#if (eq receiptResult.state "undone")}}fa-rotate-left{{else}}fa-file-shield{{/if}}" aria-hidden="true"></i>
      <div><strong>{{receiptResult.title}}{{#if receiptResult.rank}} · rank {{receiptResult.rank}}{{/if}}</strong><span>{{receiptResult.message}}</span><small>Receipt {{receiptResult.id}}</small></div>
    </section>
    {{/if}}

    {{#if receipts.length}}
    <section class="age-advancement-center__panel">
      <header class="age-advancement-center__panel-heading">
        <div><span>Targeted reversal</span><h2>Recent committed advancements</h2></div>
        <small>Undo is previewed, conflict-checked, and limited to the safe latest transaction</small>
      </header>
      <div class="age-advancement-center__receipt-list">
        {{#each receipts as |entry|}}
        <article>
          <span><strong>{{entry.definitionLabel}} · {{entry.rankLabel}}</strong><small>{{entry.stateLabel}} · {{entry.createdLabel}}</small></span>
          <button type="button" data-age-advancement-action="undo" data-receipt-id="{{entry.id}}" {{#unless entry.latest}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> Preview undo</button>
        </article>
        {{/each}}
      </div>
    </section>
    {{/if}}
    {{else}}
    <section class="age-advancement-center__empty-state">
      <i class="fa-solid fa-route"></i>
      <h2>{{#if hasDefinitions}}No compatible advancement is available{{else}}No active progression definitions{{/if}}</h2>
      <p>{{#if hasDefinitions}}This Character has no Actor or Class track matching the active rules profile. Ask a GM to review the definition binding.{{else}}Ask a GM to enable a valid Progression Definition Item for the active rules profile. Draft, disabled, and invalid definitions cannot be used.{{/if}}</p>
    </section>
    {{/if}}
  </div>

  <footer class="age-advancement-center__footer">
    <div class="age-advancement-center__commit-status" id="age-advancement-center-commit-help" aria-live="polite">
      <i class="fa-solid {{#if canCommit}}fa-circle-check{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
      <span>{{commitStatus}}</span>
    </div>
    <button type="button" data-age-advancement-action="cancel"><i class="fa-solid fa-xmark"></i> Close</button>
    {{#if hasLegacyFallback}}<button type="button" data-age-advancement-action="legacy"><i class="fa-solid fa-clock-rotate-left"></i> Use legacy advancement</button>{{/if}}
    <button type="button" data-age-advancement-action="refresh" {{#if busy}}disabled{{/if}} {{#unless advancementAvailable}}disabled{{/unless}}><i class="fa-solid fa-rotate"></i> Refresh review</button>
    <button type="button" class="age-advancement-center__commit" data-age-advancement-action="commit"
            title="{{commitStatus}}" aria-describedby="age-advancement-center-commit-help" {{#unless canCommit}}disabled{{/unless}}><i class="fa-solid fa-arrow-trend-up"></i> Apply advancement</button>
  </footer>
</section>
