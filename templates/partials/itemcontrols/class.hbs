<li class="item-box item-card flexrow feature-controls {{colorset}}" data-item-id="{{item._id}}">
    <div class="main-data flexrow">
        <img class="item-image" src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
        <a class="item-show item-name">{{item.name}} [{{localize "age-system.level"}} {{item.system.level}}]</a>
    </div>
    <div class="controls flexrow">
        <div class="flexcol item-qtd-control arrow-control">
            <a class="change-qtd" data-action="add" title="{{localize 'age-system.CLASS.advanceTitle'}}"><i class="fa fa-chevron-up"></i></a>
            <a class="change-qtd" data-action="remove" title="{{localize 'age-system.CLASS.rollbackTitle'}}"><i class="fa fa-chevron-down"></i></a>
        </div>
    </div>
</li>
